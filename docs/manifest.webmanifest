{
  "name": "Damp Tracker",
  "short_name": "Damp",
  "description": "Log moisture meter readings around the house. Data stays on your phone.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
